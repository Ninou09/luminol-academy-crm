# Local server settings. Local demo accounts are for loopback use only.
PORT=4173
# Optional absolute SQLite file path; defaults to data/luminol.sqlite
# CRM_DB=
# Set before first startup to override the demo password for all seeded users.
# DEMO_PASSWORD=
# Vercel: configure DEMO_PASSWORD as a Secret for Production and Preview.
# Use a unique password of at least 16 characters before first cloud startup.
# On Vercel only the administrator receives this password; other staff accounts
# receive independent random passwords. Changing it does not reset existing users.
# Link a PRIVATE Blob store; Vercel injects BLOB_STORE_ID and OIDC credentials.
# BLOB_STORE_ID=
