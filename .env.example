# Local server port.
PORT=4173
# Optional absolute SQLite file path; defaults to data/luminol.sqlite
# CRM_DB=
# Administrator created when a NEW database is first started.
# ADMIN_EMAIL defaults to admin@luminol.demo. The password must be at least
# 16 characters on Vercel (ADMIN_PASSWORD, or the older DEMO_PASSWORD name).
# Changing these later does not change an existing account: use
# Settings → My account inside the CRM instead.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# DEMO_PASSWORD=
# Only for automated tests / local demonstrations: fill a new database with
# fictional sample records. Never set this in production.
# SEED_SAMPLE_DATA=1
# Link a PRIVATE Blob store; Vercel injects BLOB_STORE_ID and OIDC credentials.
# BLOB_STORE_ID=
# n8n intake: a separate random 32-256 character token, configured server-side.
# On Vercel, use a Production Secret. Store the same value in the dedicated
# n8n credential. It can only capture incoming inquiries, not read CRM records.
# N8N_INTAKE_TOKEN=
# Optional receiving administrator/admissions user ID; defaults to first admin.
# N8N_INTAKE_OWNER_ID=
# Password recovery e-mails (optional). Create a free key on resend.com and
# verify your domain, then set both as Vercel environment variables.
# Without a key, "Forgot your password?" shows the same message but sends nothing;
# the administrator can still set a new password in Settings → Team.
# RESEND_API_KEY=
# MAIL_FROM=Luminol Academy <no-reply@your-domain.dz>
